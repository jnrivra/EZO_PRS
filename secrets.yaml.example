# =============================================================================
# secrets.yaml.example
# =============================================================================
# Copy this file to `secrets.yaml` and fill in your own values.
# `secrets.yaml` is gitignored and must NEVER be committed.
#
#   cp secrets.yaml.example secrets.yaml
#
# ESPHome resolves every `!secret <key>` reference against secrets.yaml.
# =============================================================================

wifi_ssid: "YourWiFiNetwork"
wifi_password: "YourWiFiPassword"

# Generate with: openssl rand -base64 32
api_encryption_key: "generate-a-32-byte-base64-key"

ota_password: "YourOTAPassword"
